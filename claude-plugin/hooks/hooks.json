{
  "description": "AgentCall: turns Claude Code questions, permissions and final results into Windows voice calls. Calls are per session: \"/saul on|off\" (\"/saul on\" also opens AgentCall). With AgentCall closed every hook exits silently and Claude Code works as usual.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agentcall-hook.js",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agentcall-hook.js",
              "user-prompt-submit"
            ],
            "timeout": 40
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agentcall-hook.js",
              "ask-user"
            ],
            "timeout": 86400,
            "statusMessage": "AgentCall: si te llama, contesta en la llamada o aquí en la terminal"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agentcall-hook.js",
              "permission"
            ],
            "timeout": 86400,
            "statusMessage": "AgentCall: si te llama, decide en la llamada o aquí en la terminal"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agentcall-hook.js",
              "post-tool-use"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agentcall-hook.js",
              "stop"
            ],
            "timeout": 86400,
            "statusMessage": "AgentCall: si te llama, contesta en la llamada o escribe aquí"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/agentcall-hook.js",
              "stop-failure"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
