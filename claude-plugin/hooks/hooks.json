{
  "description": "AgentCall: turns Claude Code questions, permissions and final results into Windows voice calls. Calls are per session: \"/better-call-saul on|off\". Every hook fails open when AgentCall is not running.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoLogo",
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:32147/hooks/user-prompt-submit",
            "headers": {
              "X-AgentCall-Mode": "${AGENTCALL_SESSION_MODE}"
            },
            "allowedEnvVars": [
              "AGENTCALL_SESSION_MODE"
            ],
            "onFailure": "continue",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:32147/hooks/ask-user",
            "headers": {
              "X-AgentCall-Mode": "${AGENTCALL_SESSION_MODE}"
            },
            "allowedEnvVars": [
              "AGENTCALL_SESSION_MODE"
            ],
            "onFailure": "continue",
            "timeout": 86400,
            "statusMessage": "AgentCall: te está llamando con esta pregunta (escribe aquí si prefieres seguir en la terminal)"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:32147/hooks/permission",
            "headers": {
              "X-AgentCall-Mode": "${AGENTCALL_SESSION_MODE}"
            },
            "allowedEnvVars": [
              "AGENTCALL_SESSION_MODE"
            ],
            "onFailure": "continue",
            "timeout": 86400,
            "statusMessage": "AgentCall: te está llamando para pedir permiso"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:32147/hooks/post-tool-use",
            "headers": {
              "X-AgentCall-Mode": "${AGENTCALL_SESSION_MODE}"
            },
            "allowedEnvVars": [
              "AGENTCALL_SESSION_MODE"
            ],
            "onFailure": "continue",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:32147/hooks/stop",
            "headers": {
              "X-AgentCall-Mode": "${AGENTCALL_SESSION_MODE}"
            },
            "allowedEnvVars": [
              "AGENTCALL_SESSION_MODE"
            ],
            "onFailure": "continue",
            "timeout": 86400,
            "statusMessage": "AgentCall: llamada de resultado en curso (escribe aquí para seguir en la terminal)"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:32147/hooks/stop-failure",
            "headers": {
              "X-AgentCall-Mode": "${AGENTCALL_SESSION_MODE}"
            },
            "allowedEnvVars": [
              "AGENTCALL_SESSION_MODE"
            ],
            "onFailure": "continue",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
